{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "db/**/*.ts",
    "src/env.ts",
    "src/lib/**/*.ts",
    "drizzle.config.ts",
    "src/app/api/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "dist", "src/app/page.tsx", "src/app/layout.tsx"]
}
