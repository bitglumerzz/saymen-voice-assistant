# =================================================================
# Saymen Next — переменные окружения
# Скопировать в .env.local и заполнить значениями.
# Никогда не коммитить .env.local в git!
# =================================================================

# ---------- База данных ----------
# Локально (через docker-compose):
DATABASE_URL=postgres://saymen:saymen_dev_password@localhost:5433/saymen_dev
# Прод (Neon, Supabase, Yandex Cloud):
# DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# ---------- LLM-провайдеры ----------
# Выбор провайдера: anthropic (Claude) или openai (GPT). Если не задан —
# выбирается автоматически: Anthropic если есть ANTHROPIC_API_KEY, иначе OpenAI.
LLM_PROVIDER=anthropic

# Anthropic Claude — рекомендуемый
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — альтернатива
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-11-20

# ---------- Голос ----------
# Deepgram: основной ASR (русский, стриминг)
DEEPGRAM_API_KEY=

# ElevenLabs: основной TTS, multilingual Turbo v2.5
ELEVENLABS_API_KEY=
# ID голоса для бота "Дмитрий". Подобрать в Voice Library, мужской 30-40
ELEVENLABS_VOICE_ID_DMITRY=

# ---------- Телефония ----------
# Voximplant: SIP-интеграция, исходящие звонки
VOXIMPLANT_ACCOUNT_ID=
VOXIMPLANT_API_KEY=
VOXIMPLANT_APPLICATION_ID=
# Номер для исходящих (формат +7XXXXXXXXXX) — наш арендованный caller ID
VOXIMPLANT_CALLER_ID=
# ID правила в Voximplant Application, к которому привязан scenario.js
VOXIMPLANT_RULE_ID=
# Публичный wss-URL оркестратора (через ngrok/cloudflared в dev). Voximplant
# подключается сюда из своих ДЦ — localhost не подойдёт.
VOXIMPLANT_PUBLIC_WS_URL=wss://your-tunnel.ngrok.io/voice

# ---------- Telegram (тестовый канал, временный) ----------
# Получить через @BotFather: /newbot → выдаст токен вида 1234:AAA...
# Если задан — оркестратор автоматически поднимет Telegram-бот в polling-режиме.
# Все диалоги пишутся в общую БД (calls + transcript_turns) — будут видны в админке.
TELEGRAM_BOT_TOKEN=
# Список Telegram user_id админов через запятую — им доступны команды /stats, /last_call, /lookup
# Узнать свой ID: написать @userinfobot в Telegram
TELEGRAM_ADMIN_IDS=

# ---------- Email (Unisender или SendPulse) ----------
UNISENDER_API_KEY=
EMAIL_FROM=hello@saymen.io
EMAIL_FROM_NAME=Антон Майоров (Saymen)

# ---------- Хранилище аудио ----------
# Yandex Object Storage (S3-совместимое)
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=saymen-recordings
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- Внутренние ----------
# Секрет для подписи webhook-ов от Voximplant
VOXIMPLANT_WEBHOOK_SECRET=change_me_to_random_string

# Базовый URL приложения (для callback-ов и трекинга email)
NEXT_PUBLIC_APP_URL=http://localhost:3030
TRACKING_URL=http://localhost:3030

# WebSocket-URL оркестратора, к которому подключается браузерный voice-tester
NEXT_PUBLIC_ORCHESTRATOR_WS_URL=ws://localhost:8181/voice

# Окружение (development | staging | production)
NODE_ENV=development
