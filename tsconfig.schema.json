{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": [
    "db/schema.ts",
    "db/index.ts",
    "src/env.ts",
    "src/lib/audio.ts",
    "src/lib/voximplant.ts",
    "drizzle.config.ts"
  ],
  "exclude": ["node_modules"]
}
